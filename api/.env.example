NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://scriptgrade:scriptgrade@localhost:5432/scriptgrade
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/storage
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

EMAIL_DRIVER=noop
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_VISION_MODEL=grok-4.5

# Vision provider (server-side). Switch models without code changes.
#   gemma    — Gemma 3.6 via OpenAI-compatible API (default)
#   spacexai — SpaceXAI / xAI (XAI_* above)
VISION_DRIVER=gemma
GEMMA_API_KEY=
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMMA_VISION_MODEL=gemma-3.6

OCR_DRIVER=noop
QUALITY_DRIVER=basic
SPELLCHECK_DRIVER=noop
SIMILARITY_DRIVER=noop

RETENTION_YEARS=5
RELEASE_EMAIL_ENABLED=false

ADMIN_BOOTSTRAP_EMAIL=admin@scriptgrade.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow1
